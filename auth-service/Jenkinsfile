pipeline {
    agent any

    environment {
        IMAGE_NAME = 'rajvi1023/auth-service'
        IMAGE_TAG  = "${BUILD_NUMBER}"
        FULL_IMAGE = "${IMAGE_NAME}:${IMAGE_TAG}"
    }

    stages {
        // =========================================================
        // 1. MAVEN BUILD
        // =========================================================

        stage('Maven Build') {
            steps {
                dir('auth-service') {
                    sh '''
                        set -e

                        echo "======================================"
                        echo "MAVEN BUILD"
                        echo "======================================"

                        mvn clean package -DskipTests

                        echo ""
                        echo "Generated JAR:"
                        ls -lh target/auth.jar
                    '''
                }
            }
        }

        // =========================================================
        // 2. DOCKER BUILD
        // =========================================================

        stage('Docker Build') {
    steps {
        dir('auth-service') {
            sh '''
                set -e

                echo "========================================="
                echo "Docker Build Debug"
                echo "========================================="

                echo "Current directory:"
                pwd

                echo "Files:"
                ls -lah

                echo "Target directory:"
                ls -lah target || true

                echo "Auth JAR:"
                ls -lh target/auth.jar

                echo "Dockerfile:"
                cat Dockerfile

                echo "Dockerignore:"
                if [ -f .dockerignore ]; then
                    cat .dockerignore
                else
                    echo "No .dockerignore found"
                fi

                echo "========================================="
                echo "Building Docker image: ${FULL_IMAGE}"
                echo "========================================="

                docker build \
                    --progress=plain \
                    -t "${FULL_IMAGE}" \
                    .
            '''
        }
    }
}

        // =========================================================
        // 3. DOCKER PUSH
        // =========================================================

        stage('Docker Push') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -e

                        echo "======================================"
                        echo "DOCKER PUSH"
                        echo "======================================"

                        echo "$DOCKER_PASSWORD" | docker login \
                            -u "$DOCKER_USERNAME" \
                            --password-stdin

                        docker push "${FULL_IMAGE}"

                        docker logout
                    '''
                }
            }
        }

        // =========================================================
        // 4. UPDATE MINIKUBE CONTEXT
        // =========================================================

        stage('Prepare Kubernetes') {
            steps {
                sh '''
                    set -e

                    echo "======================================"
                    echo "PREPARE KUBERNETES"
                    echo "======================================"

                    echo "Current context:"
                    kubectl config current-context

                    echo ""
                    echo "Current Kubernetes server:"
                    kubectl config view --minify \
                        -o jsonpath='{.clusters[0].cluster.server}'
                    echo ""

                    echo ""
                    echo "Updating Minikube context..."

                    minikube update-context

                    echo ""
                    echo "Updated Kubernetes server:"
                    kubectl config view --minify \
                        -o jsonpath='{.clusters[0].cluster.server}'
                    echo ""

                    echo ""
                    echo "Minikube status:"
                    minikube status

                    echo ""
                    echo "Testing Kubernetes:"
                    kubectl cluster-info

                    echo ""
                    echo "Nodes:"
                    kubectl get nodes
                '''
            }
        }

        // =========================================================
        // 5. DEPLOY BANKING NAMESPACE
        // =========================================================

        stage('Deploy Banking Namespace') {
            steps {
                dir('auth-service') {
                    sh '''
                        set -e

                        kubectl apply \
                            -f k8s/auth/namespace.yaml

                        kubectl get namespace banking
                    '''
                }
            }
        }

        // =========================================================
        // 6. DEPLOY MYSQL
        // =========================================================

        stage('Deploy Auth MySQL') {
            steps {
                dir('auth-service') {
                    sh '''
                        set -e

                        echo "======================================"
                        echo "DEPLOY AUTH MYSQL"
                        echo "======================================"

                        kubectl apply \
                            -f k8s/mysql/mysql-secret.yaml

                        kubectl apply \
                            -f k8s/mysql/mysql-deployment.yaml

                        kubectl apply \
                            -f k8s/mysql/mysql-service.yaml

                        echo ""
                        echo "MySQL deployment:"
                        kubectl get deployment mysql -n banking

                        echo ""
                        echo "MySQL pod:"
                        kubectl get pods \
                            -n banking \
                            -l app=mysql \
                            -o wide

                        echo ""
                        echo "MySQL service:"
                        kubectl get svc mysql -n banking

                        echo ""
                        echo "Waiting for MySQL deployment..."

                        kubectl rollout status \
                            deployment/mysql \
                            -n banking \
                            --timeout=180s

                        echo ""
                        echo "MySQL is READY"

                        echo ""
                        echo "MySQL endpoints:"
                        kubectl get endpoints mysql -n banking
                    '''
                }
            }
        }

        // =========================================================
        // 7. DEPLOY AUTH CONFIGURATION
        // =========================================================

        stage('Deploy Auth Configuration') {
            steps {
                dir('auth-service') {
                    sh '''
                        set -e

                        echo "======================================"
                        echo "DEPLOY AUTH CONFIGURATION"
                        echo "======================================"

                        kubectl apply \
                            -f k8s/auth/auth-service-config.yaml

                        kubectl apply \
                            -f k8s/auth/auth-service-secret.yaml

                        kubectl get configmap \
                            auth-service-config \
                            -n banking

                        kubectl get secret \
                            auth-service-secret \
                            -n banking
                    '''
                }
            }
        }

        // =========================================================
        // 8. DEPLOY AUTH SERVICE
        // =========================================================

        stage('Deploy Auth Service') {
            steps {
                dir('auth-service') {
                    sh '''
                        set -e

                        echo "======================================"
                        echo "DEPLOY AUTH SERVICE"
                        echo "======================================"

                        export IMAGE_TAG="${BUILD_NUMBER}"

                        echo "Deploying:"
                        echo "${FULL_IMAGE}"

                        envsubst < \
                            k8s/auth/auth-service-deployment.yaml | \
                            kubectl apply -f -

                        kubectl apply \
                            -f k8s/auth/auth-service.yaml

                        echo ""
                        echo "Deployment:"
                        kubectl get deployment auth-service -n banking

                        echo ""
                        echo "Waiting for Auth Service..."

                        if ! kubectl rollout status \
                            deployment/auth-service \
                            -n banking \
                            --timeout=180s
                        then

                            echo "======================================"
                            echo "AUTH SERVICE FAILED"
                            echo "======================================"

                            echo ""
                            echo "Pods:"
                            kubectl get pods \
                                -n banking \
                                -l app=auth-service \
                                -o wide

                            echo ""
                            echo "Services:"
                            kubectl get svc -n banking

                            echo ""
                            echo "Endpoints:"
                            kubectl get endpoints -n banking

                            echo ""
                            echo "Auth logs:"
                            kubectl logs \
                                -n banking \
                                -l app=auth-service \
                                --tail=200 || true

                            echo ""
                            echo "Auth events:"
                            kubectl get events \
                                -n banking \
                                --sort-by=.lastTimestamp \
                                | tail -50

                            exit 1
                        fi

                        echo ""
                        echo "Auth Service is READY!"
                    '''
                }
            }
        }

        // =========================================================
        // 9. DEPLOY HPA
        // =========================================================

        stage('Deploy Auth HPA') {
            steps {
                dir('auth-service') {
                    sh '''
                        set -e

                        kubectl apply \
                            -f k8s/auth/auth-service-hpa.yaml

                        kubectl get hpa -n banking
                    '''
                }
            }
        }

        // =========================================================
        // 10. DEPLOY PDB
        // =========================================================

        stage('Deploy Auth PDB') {
            steps {
                dir('auth-service') {
                    sh '''
                        set -e

                        kubectl apply \
                            -f k8s/auth/auth-service-pdb.yaml

                        kubectl get pdb -n banking
                    '''
                }
            }
        }

        // =========================================================
        // 11. FINAL VERIFICATION
        // =========================================================

        stage('Verify Kubernetes') {
            steps {
                sh '''
                    set -e

                    echo "======================================"
                    echo "KUBERNETES STATUS"
                    echo "======================================"

                    echo ""
                    echo "Deployments:"
                    kubectl get deployments -n banking

                    echo ""
                    echo "Pods:"
                    kubectl get pods -n banking -o wide

                    echo ""
                    echo "Services:"
                    kubectl get services -n banking

                    echo ""
                    echo "Endpoints:"
                    kubectl get endpoints -n banking

                    echo ""
                    echo "HPA:"
                    kubectl get hpa -n banking

                    echo ""
                    echo "PDB:"
                    kubectl get pdb -n banking

                    echo ""
                    echo "======================================"
                    echo "AUTH SERVICE DEPLOYMENT COMPLETE"
                    echo "======================================"
                '''
            }
        }

        // =========================================================
        // 12. GET SERVICE URL
        // =========================================================

        stage('Get Auth Service URL') {
            steps {
                sh '''
                    echo "======================================"
                    echo "AUTH SERVICE URL"
                    echo "======================================"

                    kubectl get svc auth-service -n banking

                    echo ""

                    minikube service \
                        auth-service \
                        -n banking \
                        --url || true
                '''
            }
        }
    }

    // =========================================================
    // POST
    // =========================================================

    post {
        success {
            echo """
            ======================================
            CI/CD SUCCESS
            ======================================

            Application : Auth Service
            Image       : ${FULL_IMAGE}
            Build       : ${BUILD_NUMBER}
            Namespace   : banking
            Port        : 8001

            ======================================
            """
        }

        failure {
            echo """
            ======================================
            CI/CD FAILED
            ======================================

            Application : Auth Service
            Image       : ${FULL_IMAGE}
            Build       : ${BUILD_NUMBER}
            Namespace   : banking

            ======================================
            """
        }

        always {
            echo "Jenkins Build: ${BUILD_NUMBER}"
            echo "Result: ${currentBuild.currentResult}"
        }
    }
}
