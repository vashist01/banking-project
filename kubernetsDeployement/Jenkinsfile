pipeline {
    agent any

    environment {
        IMAGE_NAME = 'rajvi1023/employee-service'
        IMAGE_TAG  = "${BUILD_NUMBER}"
        FULL_IMAGE = "${IMAGE_NAME}:${IMAGE_TAG}"
    }

    stages {

        // =========================================================
        // 1. CHECKOUT
        // =========================================================

        stage('Checkout') {
            steps {
                checkout scm

                sh '''
                    echo "======================================"
                    echo "CHECKOUT"
                    echo "======================================"

                    pwd
                    find . -maxdepth 3 -type f | sort
                '''
            }
        }

        // =========================================================
        // 2. BUILD
        // =========================================================

        stage('Build') {
            steps {
                dir('kubernetsDeployement') {
                    sh '''
                        echo "======================================"
                        echo "MAVEN BUILD"
                        echo "======================================"

                        mvn clean verify -DskipTests
                    '''
                }
            }
        }

        // =========================================================
        // 3. DOCKER BUILD
        // =========================================================

        stage('Docker Build') {
            steps {
                dir('kubernetsDeployement') {
                    sh '''
                        echo "======================================"
                        echo "DOCKER BUILD"
                        echo "======================================"

                        echo "Building image: ${FULL_IMAGE}"

                        docker build \
                            -t ${FULL_IMAGE} \
                            .
                    '''
                }
            }
        }

        // =========================================================
        // 4. DOCKER PUSH
        // =========================================================

        stage('Docker Push') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    sh '''
                        echo "======================================"
                        echo "DOCKER PUSH"
                        echo "======================================"

                        echo "$DOCKER_PASSWORD" | docker login \
                            -u "$DOCKER_USERNAME" \
                            --password-stdin

                        docker push ${FULL_IMAGE}

                        docker logout
                    '''
                }
            }
        }

        // =========================================================
        // 5. VERIFY KUBERNETES
        // =========================================================

        stage('Verify Kubernetes Connection') {
            steps {
                sh '''
                    echo "======================================"
                    echo "VERIFY KUBERNETES"
                    echo "======================================"

                    echo "kubectl version:"
                    kubectl version --client

                    echo ""
                    echo "Current context:"
                    kubectl config current-context

                    echo ""
                    echo "Cluster info:"
                    kubectl cluster-info

                    echo ""
                    echo "Nodes:"
                    kubectl get nodes

                    echo ""
                    echo "Namespaces:"
                    kubectl get namespaces
                '''
            }
        }

        // =========================================================
        // 6. DEPLOY MYSQL
        // =========================================================

        stage('Deploy MySQL') {
            steps {
                dir('kubernetsDeployement') {
                    sh '''
                        echo "======================================"
                        echo "DEPLOY MYSQL"
                        echo "======================================"

                        kubectl apply \
                            -f k8s/namespace.yaml

                        kubectl apply \
                            -f k8s/mysql/mysql-secret.yaml

                        kubectl apply \
                            -f k8s/mysql/mysql-deployment.yaml

                        kubectl apply \
                            -f k8s/mysql/mysql-service.yaml

                        echo ""
                        echo "Waiting for MySQL..."

                        kubectl rollout status \
                            deployment/mysql \
                            -n employee \
                            --timeout=180s
                    '''
                }
            }
        }

        // =========================================================
        // 7. DEPLOY EMPLOYEE SERVICE
        // =========================================================

        stage('Deploy Employee Service') {
            steps {
                dir('kubernetsDeployement') {
                    sh '''
                        echo "======================================"
                        echo "DEPLOY EMPLOYEE SERVICE"
                        echo "======================================"

                        export IMAGE_TAG=${BUILD_NUMBER}

                        echo "Deploying image:"
                        echo "${FULL_IMAGE}"

                        kubectl apply \
                            -f k8s/employee/employee-config.yaml

                        kubectl apply \
                            -f k8s/employee/employee-secret.yaml

                        kubectl apply \
                            -f k8s/employee/employee-service.yaml

                        envsubst < \
                            k8s/employee/employee-deployment.yaml | \
                            kubectl apply -f -

                        echo ""
                        echo "Waiting for Employee Service..."

                        kubectl rollout status \
                            deployment/employee-service \
                            -n employee \
                            --timeout=180s
                    '''
                }
            }
        }

        // =========================================================
        // 8. VERIFY
        // =========================================================

        stage('Verify Kubernetes') {
            steps {
                sh '''
                    echo "======================================"
                    echo "KUBERNETES STATUS"
                    echo "======================================"

                    echo "Deployments:"
                    kubectl get deployments -n employee

                    echo ""
                    echo "Pods:"
                    kubectl get pods -n employee -o wide

                    echo ""
                    echo "Services:"
                    kubectl get services -n employee

                    echo ""
                    echo "======================================"
                    echo "DEPLOYMENT COMPLETE"
                    echo "======================================"
                '''
            }
        }
    }

    post {

        success {
            echo """
            ======================================
            CI/CD SUCCESS
            ======================================

            Application : Employee Service
            Image       : ${FULL_IMAGE}
            Build       : ${BUILD_NUMBER}

            Deployment completed successfully.

            ======================================
            """
        }

        failure {
            echo """
            ======================================
            CI/CD FAILED
            ======================================

            Application : Employee Service
            Build       : ${BUILD_NUMBER}

            Please check Jenkins logs.

            ======================================
            """
        }

        always {
            echo "Jenkins Build: ${BUILD_NUMBER}"
            echo "Result: ${currentBuild.currentResult}"
        }
    }
}